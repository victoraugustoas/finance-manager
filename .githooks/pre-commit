#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running prettier and eslint on staged .ts files..."

for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    npx prettier --write "$FILE"
    npx eslint --fix "$FILE"
    git add "$FILE"
  fi
done
