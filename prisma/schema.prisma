// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id             String        @id @default(uuid())
  name           String        @unique
  balance        Int
  openingBalance Int
  transactions   Transaction[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id            String        @id @default(uuid())
  name          String
  type          CategoryType
  subCategories SubCategory[]
  transactions  Transaction[]

  @@unique([name, type])
}

model SubCategory {
  id           String        @id @default(uuid())
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Foreign key columns live only on `Transaction`. Prisma still requires inverse `transactions`
// relation lists on parent models; they do not add columns there, only ORM navigation.
model Transaction {
  id               String          @id @default(uuid())
  name             String
  /// Amount in minor units (cents), aligned with `Money.amountInCents`.
  amount           Int
  notes            String?
  dueDate          DateTime
  entryDate        DateTime
  effectivatedDate DateTime?
  effectivated     Boolean
  type             TransactionType
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  subCategoryId    String
  subCategory      SubCategory     @relation(fields: [subCategoryId], references: [id])
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([categoryId])
  @@index([subCategoryId])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String            @id
  eventName     String
  payload       Json
  occurredAt    DateTime
  status        OutboxEventStatus @default(PENDING)
  processedAt   DateTime?
  attempts      Int               @default(0)
  lastError     String?
  createdAt     DateTime          @default(now())

  @@index([status, createdAt])
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String
  handler     String
  processedAt DateTime @default(now())

  @@unique([eventId, handler])
}
